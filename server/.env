# =============================================
# PhotoBook Builder - Environment Configuration
# =============================================

# Server
PORT=3000
NODE_ENV=development

# MySQL Database
# Ganti dengan credentials MySQL kamu
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=photobook

# JWT Secret (generate random string untuk production)
JWT_SECRET=photobook-super-secret-key-2024-change-in-production

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
